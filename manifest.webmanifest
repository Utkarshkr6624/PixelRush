{
  "name": "PixelRush — Free Browser Arcade",
  "short_name": "PixelRush",
  "description": "PixelRush is a free browser arcade with 24 instant-play games — arcade, puzzle, racing, strategy, casual and sports. No download, no signup, plays in one tap.",
